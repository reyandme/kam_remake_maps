	A.AIDefencePositionAdd(5, 98, 32, DIRECTION_SE, GROUP_RANGED, 50, 0);
	A.AIDefencePositionAdd(5, 103, 29, DIRECTION_SE, GROUP_RANGED, 50, 0);
	A.AIDefencePositionAdd(5, 107, 33, DIRECTION_SE, GROUP_ANTIHORSE, 40, 0);
