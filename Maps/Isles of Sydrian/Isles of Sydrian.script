procedure OnTick();
begin
if S.PlayerDefeated(2) and (Isle2 = false) and S.FogRevealed(0, 185, 225) then
    begin
	A.ShowMsg(0, '<$2>');
	ChangeHouseOwner(185, 226, 0);
	Isle2:= true;
	Assault:= false;
	Clock[0]:= true;
	Offset[0]:= S.GameTime + 4800 + (S.KamRandomI(2400));
	A.AIAttackRemoveAll(9);
	end;

if S.GameTime = (CutScene[0] + 50) then
    begin
	Assault:= true;
	A.CinematicEnd(0);
	case DifficultySetting of
	    mdEasy1:
        begin
		A.GiveGroup(9, UNIT_MILITIA, 163, 228, DIRECTION_SW, 10, 5);
		A.GiveGroup(9, UNIT_LANCE_CARRIER, 169, 234, DIRECTION_SW, 6, 3);
        end;
		
        mdNormal:
        begin
		A.GiveGroup(9, UNIT_MILITIA, 163, 228, DIRECTION_SW, 15, 5);
		A.GiveGroup(9, UNIT_LANCE_CARRIER, 169, 234, DIRECTION_SW, 6, 3);
        end;
		
        mdHard1:
        begin
		A.GiveGroup(9, UNIT_MILITIA, 163, 228, DIRECTION_SW, 15, 5);
		A.GiveGroup(9, UNIT_LANCE_CARRIER, 169, 234, DIRECTION_SW, 9, 3);
        end;
    end;
	end;
	
if S.GameTime = (CutScene[1] + 50) then
    begin
	A.CinematicEnd(0);
	ChangeHouseOwner(213, 125, 0);
	end;
	
if S.GameTime = (CutScene[1] + 400) then
    begin
	A.ShowMsg(0, '<$8>');
	end;
	
if S.GameTime = (CutScene[1] + 18000) then
    begin
	A.ShowMsg(0, '<$11>');
	end;	
	
if S.GameTime = (CutScene[2] + 50) then
    begin
	A.CinematicEnd(0);
	ChangeHouseOwner(37, 88, 0);
	end;
	
	
if S.GameTime = (CutScene[2] + 400) then
    begin
	A.ShowMsg(0, '<$10>');
	end;

if S.GameTime = (CutScene[2] + 6000) then
    begin
	A.ShowMsg(0, '<$12>');
	end;	
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////STOREHOUSE BLOCK///////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
if (S.GameTime MOD 10 = 0) and (Stage = 1) and (S.HouseOwner(PortStore[0]) = 0) then
    begin
	Block_All_Wares_Except(PortStore[0], [WARE_GOLD, WARE_WINE]);
	end;
	
if (S.GameTime MOD 10 = 0) and (Stage = 2) and (S.HouseOwner(PortStore[0]) = 0) then
    begin
	Block_All_Wares_Except(PortStore[0], [WARE_TREE_TRUNK, WARE_GOLD, WARE_WINE]);
	end;
	
if (S.GameTime MOD 10 = 0) and (Stage = 3) and (S.HouseOwner(PortStore[0]) = 0) then
    begin
	Block_All_Wares_Except(PortStore[0], [WARE_TREE_TRUNK, WARE_LOAVES, WARE_GOLD, WARE_WINE, WARE_LEATHER]);
	end;	
	
if (S.GameTime MOD 10 = 0) and (Stage = 2)and (S.HouseOwner(PortStore[1]) = 0) then
    begin
	Block_All_Wares_Except(PortStore[1], [WARE_GOLD, WARE_CORN]);
	end;
	
if (S.GameTime MOD 10 = 0) and (Stage = 3) and (S.HouseOwner(PortStore[1]) = 0) then
    begin
	Block_All_Wares_Except(PortStore[1], [WARE_GOLD, WARE_CORN, WARE_SAUSAGES, WARE_TIMBER]);
	end;
	
if (S.GameTime MOD 10 = 0) and (Stage = 3) and (S.HouseOwner(PortStore[2]) = 0) then
    begin
	Block_All_Wares_Except(PortStore[2], [WARE_COAL, WARE_IRON]);
	end;	
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////STOREHOUSE TRANSFERS/////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
if (Stage = 1) and (countdown[0] = 0) and (S.HouseOwner(PortStore[0]) = 0) then
    begin
	Ware_Transfer(PortStore[0], S.HouseAt(185, 226));
	Offset[0]:= S.GameTime + 4800 + (S.KamRandomI(2400));
	end;
	
if (Stage = 2) and (countdown[0] = 0) and (S.HouseOwner(PortStore[0]) = 0) then
    begin
	Ware_Transfer(PortStore[0], S.HouseAt(213, 126));
	Offset[0]:= S.GameTime + 4800 + (S.KamRandomI(2400));
	end;

if (Stage = 3) and (countdown[0] = 0) and (S.HouseOwner(PortStore[0]) = 0) then
    begin
	Ware_Transfer(PortStore[0], S.HouseAt(37, 88));
	Offset[0]:= S.GameTime + 4800 + (S.KamRandomI(2400));
	end;	

if (Stage = 2) and (countdown[1] = 0) and (S.HouseOwner(PortStore[1]) = 0) then
    begin
	Ware_Transfer(PortStore[1], S.HouseAt(213, 126));
	Offset[1]:= S.GameTime + 5400 + (S.KamRandomI(2400));
	end;
	
if (Stage = 3) and (countdown[1] = 0) and (S.HouseOwner(PortStore[1]) = 0) then
    begin
	Ware_Transfer(PortStore[1], S.HouseAt(37, 88));
	Offset[1]:= S.GameTime + 5400 + (S.KamRandomI(2400));
	end;
	
if (Stage = 3) and (countdown[2] = 0) and (S.HouseOwner(PortStore[2]) = 0) then
    begin
	Ware_Transfer(PortStore[2], S.HouseAt(37, 88));
	Offset[2]:= S.GameTime + 6000 + (S.KamRandomI(2400));
	end;
	
If Clock[0] then
	begin
		countdown[0] := Offset[0] - S.GameTime;
		if countdown[0] > 0 then
		begin
			A.OverlayTextSet(0,'<$3>: '+ U.TimeToString(countdown[0]));
		end;
	end;

If Clock[1] then
	begin
		countdown[1] := Offset[1] - S.GameTime;
		if countdown[1] > 0 then
		begin
			A.OverlayTextAppend(0,'|<$4>: '+ U.TimeToString(countdown[1]));
		end;
	end;

If Clock[2] then
	begin
		countdown[2]:= Offset[2] - S.GameTime;
		if countdown[2] > 0 then
		begin
			A.OverlayTextAppend(0,'|<$5>: '+ U.TimeToString(countdown[2]));
		end;
	end;	
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////

if (S.GameTime MOD 16500 = 0) then
    begin
    if (S.HouseDestroyed(AIMarket[0]) = false) and (S.HouseType(AIMarket[0]) = HOUSE_MARKETPLACE) then
        begin
        A.MarketSetTrade(AIMarket[0], WARE_GOLD, WARE_CORN, 30);
        end;
    
    if (S.HouseDestroyed(AIMarket[1]) = false) and (S.HouseType(AIMarket[1]) = HOUSE_MARKETPLACE) then
        begin
        A.MarketSetTrade(AIMarket[1], WARE_GOLD, WARE_CORN, 20);
        end;
    end;
		
////////////////////////////////////////////////ATTACK LOOPS/////////////////////////////////////////////////////
