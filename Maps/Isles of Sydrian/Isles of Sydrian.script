	A.AIDefencePositionAdd(8, 80, 120, DIRECTION_NW, GROUP_MELEE, 45, 0);
	AIattack[2]:= true;
	end;
	
if (S.GameTime MOD 10 = 0) and ((S.StatArmyCount(8) > 227) or (S. StatArmyCount(8) = 227)) and (AIattack[2] = true) then
    begin
	A.AIDefencePositionRemove(8, 78, 142);
	A.AIDefencePositionRemove(8, 73, 141);
	A.AIDefencePositionRemove(8, 77, 138);
	A.AIDefencePositionRemove(8, 74, 137);
	A.AIDefencePositionRemove(8, 83, 118);
	A.AIDefencePositionRemove(8, 80, 120);
	A.AIDefencePositionRemove(8, 80, 121);
	end;	
	
if (S.GameTime MOD 10 = 0) and (S.StatArmyCount(8) < 170) and (AIattack[2] = true) then
    begin
	A.AIDefencePositionAdd(8, 90, 149, DIRECTION_W, GROUP_RANGED, 20, 0);
	A.AIDefencePositionAdd(8, 119, 125, DIRECTION_W, GROUP_RANGED, 50, 0);
	A.AIDefencePositionAdd(8, 107, 156, DIRECTION_W, GROUP_RANGED, 50, 0);
	A.AIDefencePositionAdd(8, 109, 113, DIRECTION_W, GROUP_ANTIHORSE, 40, 0);
	A.AIDefencePositionAdd(8, 102, 155, DIRECTION_W, GROUP_ANTIHORSE, 40, 0);
	A.AIDefencePositionAdd(8, 112, 135, DIRECTION_W, GROUP_MELEE, 45, 0);
	A.AIDefencePositionAdd(8, 92, 158, DIRECTION_W, GROUP_MELEE, 45, 0);
	AIattack[2]:= false;
	end;
	
////////////////////////////////////////////ATTACKS ON CONTROLLED ISLES///////////////////////////////////////////////	
end;


procedure OnPlayerDefeated(aIndex: Integer);
begin
if  (aIndex = 2) then
	begin
	A.ShowMsg(0, '<$6>');
	A.CinematicStart(0);
	A.CinematicPanTo(0, 135, 248, 50);
	A.FogRevealCircle(0, 135, 248, 17);
	A.GiveGroup(0, UNIT_BOWMAN, 141, 245, DIRECTION_NE, 8, 4);
	A.GiveGroup(0, UNIT_LANCE_CARRIER, 137, 242, DIRECTION_NE, 6, 3);
	A.GiveGroup(0, UNIT_AXE_FIGHTER, 142, 247, DIRECTION_NE, 6, 3);
	ChangeHouseOwner(83, 226, 0);
	A.GiveUnit(0, UNIT_SERF, 136, 246, 0);
	A.GiveUnit(0, UNIT_SERF, 137, 247, 0);
	A.GiveUnit(0, UNIT_SERF, 137, 248, 0);
	A.GiveUnit(0, UNIT_SERF, 138, 249, 0);
	A.GiveUnit(0, UNIT_SERF, 139, 249, 0);
	Builder[0]:= A.GiveUnit(0, UNIT_LABORER, 135, 245, 0);
	Builder[1]:= A.GiveUnit(0, UNIT_LABORER, 135, 246, 0);
	Builder[2]:= A.GiveUnit(0, UNIT_LABORER, 136, 247, 0);
	Builder[3]:= A.GiveUnit(0, UNIT_LABORER, 138, 248, 0);
	CutScene[0]:= S.GameTime;
	PortStore[0]:= S.HouseAt(83, 226);
	Stage:= Stage + 1;
	A.AIRecruitDelay(3, S.GameTime + 6000);
    A.AIRecruitDelay(4, S.GameTime + 6000);
	end;
	
if  (aIndex = 3) then
	begin
	A.ShowMsg(0, '<$7>');
	A.CinematicStart(0);
	A.CinematicPanTo(0, 213, 125, 50);
	A.FogRevealCircle(0, 213, 125, 28);
	ChangeHouseOwner(238, 180, 0);
	A.GiveUnit(0, UNIT_SERF, 214, 137, 0);
	A.GiveUnit(0, UNIT_SERF, 215, 137, 0);
	A.GiveUnit(0, UNIT_SERF, 216, 137, 0);
	A.GiveUnit(0, UNIT_SERF, 214, 138, 0);
	A.GiveUnit(0, UNIT_SERF, 215, 138, 0);
	A.GiveUnit(0, UNIT_SERF, 216, 138, 0);
	A.GiveUnit(0, UNIT_LABORER, 214, 139, 0);
	A.GiveUnit(0, UNIT_LABORER, 215, 139, 0);
	A.GiveUnit(0, UNIT_LABORER, 216, 139, 0);
	A.GiveUnit(0, UNIT_LABORER, 214, 140, 0);
	A.GiveUnit(0, UNIT_LABORER, 215, 140, 0);
	CutScene[1]:= S.GameTime;
	Clock[1]:= true;
	Offset[1]:= S.GameTime + 5400 + (S.KamRandomI(2400));
	PortStore[1]:= S.HouseAt(238, 180);
	Stage:= Stage + 1;
	A.AIRecruitDelay(5, (S.GameTime + 3000));
    A.AIRecruitDelay(6, (S.GameTime + 3150));
	end;

if  (aIndex = 5) then
	begin
	A.ShowMsg(0, '<$9>');
	A.CinematicStart(0);
	A.CinematicPanTo(0, 37, 87, 50);
	A.FogRevealCircle(0, 37, 87, 30);
	ChangeHouseOwner(118, 65, 0);
	A.GiveUnit(0, UNIT_SERF, 28, 84, 0);
	A.GiveUnit(0, UNIT_SERF, 29, 84, 0);
	A.GiveUnit(0, UNIT_SERF, 30, 84, 0);
	A.GiveUnit(0, UNIT_SERF, 31, 84, 0);
	A.GiveUnit(0, UNIT_SERF, 32, 84, 0);
	A.GiveUnit(0, UNIT_LABORER, 28, 86, 0);
	A.GiveUnit(0, UNIT_LABORER, 29, 86, 0);
	A.GiveUnit(0, UNIT_LABORER, 30, 86, 0);
	A.GiveUnit(0, UNIT_LABORER, 31, 86, 0);
	CutScene[2]:= S.GameTime;
	Clock[2]:= true;
	Offset[2]:= S.GameTime + 6000 + (S.KamRandomI(2400));
	PortStore[2]:= S.HouseAt(118, 65);
	Stage:= Stage + 1;
	case DifficultySetting of
	    mdEasy1:
        begin
		A.GiveGroup(0, UNIT_CROSSBOWMAN, 43, 89, DIRECTION_SE, 9, 3);
		A.GiveGroup(0, UNIT_KNIGHT, 49, 90, DIRECTION_SE, 9, 3);
		A.GiveGroup(0, UNIT_SWORD_FIGHTER, 44, 95, DIRECTION_SE, 9, 3);
		A.GiveGroup(0, UNIT_PIKEMAN, 31, 95, DIRECTION_SW, 9, 3);
		AI8:= S.GameTime + 8000;
        AI9:= S.GameTime + 9100;
		A.AIRecruitDelay(7, (S.GameTime + 8300));
        A.AIRecruitDelay(8, (S.GameTime + 9500));
        end;
		
        mdNormal:
        begin
		A.GiveGroup(0, UNIT_CROSSBOWMAN, 43, 89, DIRECTION_SE, 6, 3);
		A.GiveGroup(0, UNIT_KNIGHT, 49, 90, DIRECTION_SE, 6, 3);
		A.GiveGroup(0, UNIT_SWORD_FIGHTER, 44, 95, DIRECTION_SE, 9, 3);
		A.GiveGroup(0, UNIT_PIKEMAN, 31, 95, DIRECTION_SW, 9, 3);
		AI8:= S.GameTime + 7300;
        AI9:= S.GameTime + 8200;
		A.AIRecruitDelay(7, (S.GameTime + 7500));
        A.AIRecruitDelay(8, (S.GameTime + 8600));
        end;
		
        mdHard1:
        begin
		A.GiveGroup(0, UNIT_CROSSBOWMAN, 43, 89, DIRECTION_SE, 6, 3);
		A.GiveGroup(0, UNIT_KNIGHT, 49, 90, DIRECTION_SE, 6, 3);
		A.GiveGroup(0, UNIT_SWORD_FIGHTER, 44, 95, DIRECTION_SE, 6, 3);
		A.GiveGroup(0, UNIT_PIKEMAN, 31, 95, DIRECTION_SW, 6, 3);
		AI8:= S.GameTime + 6700;
        AI9:= S.GameTime + 7900;
		A.AIRecruitDelay(7, (S.GameTime + 6900));
        A.AIRecruitDelay(8, (S.GameTime + 8300));
        end;
    end;
	end;	
end;

procedure OnHouseDestroyed(aHouseID: Integer; aDestroyerIndex: Integer);
begin
    if ((aHouseID = S.HouseAt(33, 220)) and (S.HouseOwner(S.HouseAt(33, 220)) = 0)) or ((aHouseID = PortStore[0]) and (S.HouseOwner(PortStore[0]) = 0)) or ((aHouseID = S.HouseAt(185, 226)) and (S.HouseOwner(S.HouseAt(185, 226)) = 0)) or ((aHouseID = PortStore[1]) and (S.HouseOwner(PortStore[1]) = 0)) or ((aHouseID = S.HouseAt(213, 126)) and (S.HouseOwner(S.HouseAt(213, 126)) = 0)) or ((aHouseID = PortStore[2]) and (S.HouseOwner(PortStore[2]) = 0)) or ((aHouseID = S.HouseAt(37, 88)) and (S.HouseOwner(S.HouseAt(37, 88)) = 0)) then
	begin
	A.PlayerDefeat(0);
	end;
end;

procedure OnUnitDied(aUnitThatWasKilled: Integer; aPlayerWhoKilledUnit: Integer);
begin
if (Assault = true) and ((S.UnitDead(Builder[0]) = true)) and ((S.UnitDead(Builder[1]) = true)) and ((S.UnitDead(Builder[2]) = true)) and ((S.UnitDead(Builder[3]) = true)) then
    begin
	A.PlayerDefeat(0);
	end;
end;

