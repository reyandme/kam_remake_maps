procedure OnMissionStart();
begin
  Actions.PlayerShareFog(0, 1, false);
  Actions.PlayerShareFog(1, 0, false);
  Actions.PlayerShareFog(0, 2, false);
  Actions.PlayerShareFog(2, 0, false);
end;


procedure OnTick();
begin
  if (States.GameTime() = 100) then
  begin
    Actions.ShowMsg(0, '<$0>');
  end;
end;
