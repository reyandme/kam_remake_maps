var
  aFirstGroups: array[0..4] of Integer;
  aSecondGroups: array[0..4] of Integer;
  aThirdGroups: array[0..4] of Integer;


procedure LockBuildings(iPlayer: Byte);
var
  i: Byte;

begin
  for i := 0 to 29 do
  begin
    if (i <> 26) then
    begin
      Actions.HouseAllow(iPlayer, i, false);
    end;
  end;

  Actions.HouseAllow(iPlayer, 11, true); // Storehouse
end;


procedure TraditionalUnlock(iPlayer: Byte; iHouseID: Integer);
begin
  case States.HouseType(iHouseID) of
    0: begin // Sawmill
      Actions.HouseAllow(iPlayer, 3, true); // Coal mine
      Actions.HouseAllow(iPlayer, 4, true); // Iron mine
      Actions.HouseAllow(iPlayer, 5, true); // Gold mine
      Actions.HouseAllow(iPlayer, 6, true); // Fisherman's
      Actions.HouseAllow(iPlayer, 8, true); // Farm
      Actions.HouseAllow(iPlayer, 19, true); // Weapons workshop
      Actions.HouseAllow(iPlayer, 21, true); // Barracks
      Actions.HouseAllow(iPlayer, 28, true); // Vineyard
    end;
    1: begin // Iron smithy
      Actions.HouseAllow(iPlayer, 2, true); // Weapon smithy
      Actions.HouseAllow(iPlayer, 10, true); // Armor smithy
    end;
    4: begin // Iron mine
      Actions.HouseAllow(iPlayer, 1, true); // Iron smithy
    end;
    5: begin // Gold mine
      Actions.HouseAllow(iPlayer, 15, true); // Metallurgist's
    end;
    8: begin // Farm
      Actions.HouseAllow(iPlayer, 12, true); // Stables
      Actions.HouseAllow(iPlayer, 16, true); // Swine farm
      Actions.HouseAllow(iPlayer, 22, true); // Mill
    end;
    9: begin // Woodcutter's
      Actions.HouseAllow(iPlayer, 0, true); // Sawmill
    end;
    11: begin // Storehouse
      Actions.HouseAllow(iPlayer, 13, true); // Schoolhouse
    end;
    13: begin // Schoolhouse
      Actions.HouseAllow(iPlayer, 27, true); // Inn
    end;
    14: begin // Quarry
      Actions.HouseAllow(iPlayer, 9, true); // Woodcutter's
      Actions.HouseAllow(iPlayer, 17, true); // Watchtower
    end;
    15: begin // Metallurgist's
      Actions.HouseAllow(iPlayer, 18, true); // Town hall
    end;
    16: begin // Swine farm
      Actions.HouseAllow(iPlayer, 24, true); // Butcher's
      Actions.HouseAllow(iPlayer, 25, true); // Tannery
    end;
    22: begin // Mill
      Actions.HouseAllow(iPlayer, 7, true); // Bakery
    end;
    25: begin // Tannery
      Actions.HouseAllow(iPlayer, 20, true); // Armory workshop
    end;
    27: begin // Inn
      Actions.HouseAllow(iPlayer, 14, true); // Quarry
    end;
  end;
end;


procedure OnMissionStart();
var
  h: Integer;
  aHouses: array of Integer;

begin
  LockBuildings(0);

  aHouses := States.PlayerGetAllHouses(0);

  for h := 0 to Length(aHouses) - 1 do
  begin
    TraditionalUnlock(0, aHouses[h]);
  end;

  aFirstGroups[0] := States.GroupAt(56, 127); // Militia
  aFirstGroups[1] := States.GroupAt(63, 125); // Scout
  aFirstGroups[2] := States.GroupAt(62, 129); // Lance carrier
  aFirstGroups[3] := States.GroupAt(62, 133); // Rogue

  aSecondGroups[0] := States.GroupAt(109, 8); // Lance carrier
  aSecondGroups[1] := States.GroupAt(111, 4); // Militia
  aSecondGroups[2] := States.GroupAt(114, 5); // Vagabond
  aSecondGroups[3] := States.GroupAt(117, 2); // Vagabond

  aThirdGroups[0] := States.GroupAt(73, 137); // Knight
  aThirdGroups[1] := States.GroupAt(76, 135); // Pikeman
  aThirdGroups[2] := States.GroupAt(80, 132); // Axe fighter
  aThirdGroups[3] := States.GroupAt(66, 138); // Crossbowman
  aThirdGroups[4] := States.GroupAt(80, 141); // Bowman
end;


procedure OnHouseBuilt(aHouseID: Integer);
var
  iOwner: Byte;

begin
  iOwner := States.HouseOwner(aHouseID);

  if (iOwner = 0) then
  begin
    TraditionalUnlock(iOwner, aHouseID);
  end;
end;


procedure OnTick();
begin
  if (States.GameTime() = 50) then
  begin
    Actions.ShowMsg(0, '<$0>');
  end;

  if (States.GameTime() = 600) then
  begin
    Actions.GroupOrderWalk(aFirstGroups[0], 58, 89, 0);
    Actions.GroupOrderWalk(aFirstGroups[1], 62, 87, 0);
    Actions.GroupOrderWalk(aFirstGroups[2], 66, 90, 0);
    Actions.GroupOrderWalk(aFirstGroups[3], 62, 93, 0);
  end;

  if (States.GameTime() = 850) then
  begin
    Actions.GroupOrderWalk(aSecondGroups[0], 31, 18, 6);
    Actions.GroupOrderWalk(aSecondGroups[1], 32, 23, 6);
    Actions.GroupOrderWalk(aSecondGroups[2], 27, 19, 6);
    Actions.GroupOrderWalk(aSecondGroups[3], 28, 24, 6);
  end;

  if (States.GameTime() = 1200) then
  begin
    Actions.GroupOrderWalk(aThirdGroups[0], 65, 89, 0);
    Actions.GroupOrderWalk(aThirdGroups[1], 69, 88, 0);
    Actions.GroupOrderWalk(aThirdGroups[2], 73, 87, 0);
    Actions.GroupOrderWalk(aThirdGroups[3], 67, 94, 0);
    Actions.GroupOrderWalk(aThirdGroups[4], 72, 92, 0);
  end;
end;
