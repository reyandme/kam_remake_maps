var
  aFirstGroups: array[0..6] of Integer;
  aSecondGroups: array[0..6] of Integer;


procedure OnMissionStart();
begin
  aFirstGroups[0] := States.GroupAt(41, 15); // Sword fighter
  aFirstGroups[1] := States.GroupAt(41, 35); // Sword fighter
  aFirstGroups[2] := States.GroupAt(44, 49); // Sword fighter
  aFirstGroups[3] := States.GroupAt(57, 23); // Knight
  aFirstGroups[4] := States.GroupAt(41, 56); // Knight
  aFirstGroups[5] := States.GroupAt(36, 56); // Axe fighter

  aSecondGroups[0] := States.GroupAt(23, 34); // Axe fighter
  aSecondGroups[1] := States.GroupAt(23, 44); // Axe fighter
  aSecondGroups[2] := States.GroupAt(18, 34); // Pikeman
  aSecondGroups[3] := States.GroupAt(18, 44); // Pikeman
  aSecondGroups[4] := States.GroupAt(8, 34); // Axe fighter
  aSecondGroups[5] := States.GroupAt(8, 44); // Axe fighter
  aSecondGroups[6] := States.GroupAt(25, 39); // Knight
end;


procedure OnTick();
begin
  if (States.GameTime() = 10) then
  begin
    Actions.GroupOrderWalk(aFirstGroups[0], 68, 30, 2);
    Actions.GroupOrderWalk(aFirstGroups[1], 68, 35, 2);
    Actions.GroupOrderWalk(aFirstGroups[2], 69, 40, 2);
    Actions.GroupOrderWalk(aFirstGroups[3], 69, 28, 3);
  end;

  if (States.GameTime() = 20) then
  begin
    Actions.GroupOrderWalk(aFirstGroups[4], 66, 50, 1);
    Actions.GroupOrderWalk(aFirstGroups[5], 71, 54, 0);
  end;

  if (States.GameTime() = 200) then
  begin
    Actions.GroupOrderWalk(aSecondGroups[0], 76, 33, 2);
    Actions.GroupOrderWalk(aSecondGroups[1], 77, 38, 2);
    Actions.GroupOrderWalk(aSecondGroups[2], 72, 34, 2);
    Actions.GroupOrderWalk(aSecondGroups[3], 73, 38, 2);
    Actions.GroupOrderWalk(aSecondGroups[4], 68, 33, 2);
    Actions.GroupOrderWalk(aSecondGroups[5], 69, 38, 2);
  end;

  if (States.GameTime() = 300) then
  begin
    Actions.GroupOrderWalk(aSecondGroups[6], 66, 38, 2);
  end;
end;
