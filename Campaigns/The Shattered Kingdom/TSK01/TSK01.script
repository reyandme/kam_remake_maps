var
  bUnitsAttacked: Boolean;
  bMessageShowed: Boolean;
  aGroups: array[0..3] of Integer;


procedure LockBuildings(iPlayer: Byte);
var
  i: Byte;

begin
  for i := 0 to 29 do
  begin
    if (i <> 26) then
    begin
      Actions.HouseAllow(iPlayer, i, false);
    end;
  end;

  Actions.HouseAllow(iPlayer, 11, true); // Storehouse
end;


procedure TraditionalUnlock(iPlayer: Byte; iHouseID: Integer);
begin
  case States.HouseType(iHouseID) of
    0: begin // Sawmill
      Actions.HouseAllow(iPlayer, 28, true); // Vineyard
      Actions.HouseAllow(iPlayer, 8, true); // Farm
      Actions.HouseAllow(iPlayer, 19, true); // Weapons workshop
      Actions.HouseAllow(iPlayer, 21, true); // Barracks
    end;
    1: begin // Iron smithy
      Actions.HouseAllow(iPlayer, 2, true); // Weapon smithy
      Actions.HouseAllow(iPlayer, 10, true); // Armor smithy
    end;
    4: begin // Iron mine
      Actions.HouseAllow(iPlayer, 1, true); // Iron smithy
    end;
    5: begin // Gold mine
      Actions.HouseAllow(iPlayer, 15, true); // Metallurgist's
    end;
    8: begin // Farm
      Actions.HouseAllow(iPlayer, 22, true); // Mill
    end;
    9: begin // Woodcutter's
      Actions.HouseAllow(iPlayer, 0, true); // Sawmill
    end;
    11: begin // Storehouse
      Actions.HouseAllow(iPlayer, 13, true); // Schoolhouse
    end;
    13: begin // Schoolhouse
      Actions.HouseAllow(iPlayer, 27, true); // Inn
    end;
    14: begin // Quarry
      Actions.HouseAllow(iPlayer, 9, true); // Woodcutter's
    end;
    16: begin // Swine farm
      Actions.HouseAllow(iPlayer, 24, true); // Butcher's
      Actions.HouseAllow(iPlayer, 25, true); // Tannery
    end;
    22: begin // Mill
      Actions.HouseAllow(iPlayer, 7, true); // Bakery
    end;
    25: begin // Tannery
      Actions.HouseAllow(iPlayer, 20, true); // Armory workshop
    end;
    27: begin // Inn
      Actions.HouseAllow(iPlayer, 9, true); // Woodcutter's
      Actions.HouseAllow(iPlayer, 14, true); // Quarry
    end;
  end;
end;


procedure SetupAI();
var
  p: Byte;
  h: Integer;
  aHouses: array of Integer;

begin
  for p := 0 to States.StatPlayerCount() - 1 do
  begin
    if States.PlayerIsAI(p) then
    begin
      // Iron
      Actions.PlayerWareDistribution(p, 6, 2, 5); // Weapon smithy
      Actions.PlayerWareDistribution(p, 6, 10, 5); // Armor smithy

      // Coal
      Actions.PlayerWareDistribution(p, 5, 1, 5); // Iron smithy
      Actions.PlayerWareDistribution(p, 5, 15, 5); // Metallurgist's
      Actions.PlayerWareDistribution(p, 5, 2, 5); // Weapon smithy
      Actions.PlayerWareDistribution(p, 5, 10, 5); // Armor smithy

      // Timber
      Actions.PlayerWareDistribution(p, 2, 20, 5); // Armory workshop
      Actions.PlayerWareDistribution(p, 2, 19, 5); // Weapons workshop

      // Corn
      Actions.PlayerWareDistribution(p, 9, 22, 5); // Mill
      Actions.PlayerWareDistribution(p, 9, 16, 5); // Swine farm
      Actions.PlayerWareDistribution(p, 9, 12, 5); // Stables

      aHouses := States.PlayerGetAllHouses(p);

      for h := 0 to Length(aHouses) - 1 do
      begin
        if (States.HouseType(aHouses[h]) = 11) then
        begin
          Actions.HouseWareBlock(aHouses[h], 0, true); // Tree trunks
          Actions.HouseWareBlock(aHouses[h], 3, true); // Iron ore
          Actions.HouseWareBlock(aHouses[h], 4, true); // Gold ore
          Actions.HouseWareBlock(aHouses[h], 5, true); // Coal
          Actions.HouseWareBlock(aHouses[h], 6, true); // Iron
          Actions.HouseWareBlock(aHouses[h], 9, true); // Corn
          Actions.HouseWareBlock(aHouses[h], 11, true); // Flour
          Actions.HouseWareBlock(aHouses[h], 12, true); // Leather
          Actions.HouseWareBlock(aHouses[h], 14, true); // Pigs
          Actions.HouseWareBlock(aHouses[h], 15, true); // Skins
        end;
      end;
    end;
  end;
end;


procedure OnMissionStart();
var
  h: Integer;
  aHouses: array of Integer;

begin
  LockBuildings(0);

  SetupAI();

  aHouses := States.PlayerGetAllHouses(0);

  for h := 0 to Length(aHouses) - 1 do
  begin
    TraditionalUnlock(0, aHouses[h]);
  end;

  aGroups[0] := States.GroupAt(55, 71); // Lance carrier
  aGroups[1] := States.GroupAt(51, 62); // Axe fighter
  aGroups[2] := States.GroupAt(58, 63); // Lance carrier
  aGroups[3] := States.GroupAt(46, 73); // Lance carrier

  Actions.UnitBlock(2, 17, true); // Bowman
  Actions.UnitBlock(2, 19, true); // Lance carrier
end;


procedure OnHouseBuilt(aHouseID: Integer);
var
  iOwner: Byte;

begin
  iOwner := States.HouseOwner(aHouseID);

  if (iOwner = 0) then
  begin
    TraditionalUnlock(iOwner, aHouseID);
  end;
end;


procedure OnUnitAttacked(aUnitID: Integer; aAttackerID: Integer);
var
  g: Byte;

begin
  if not bUnitsAttacked then
  begin
    if (States.UnitOwner(aUnitID) = 4) and (States.UnitOwner(aAttackerID) = 0) then
    begin
      for g := 0 to Length(aGroups) - 1 do
      begin
        Actions.GroupOrderHalt(aGroups[g]);
        Actions.GroupOrderAttackUnit(aGroups[g], aAttackerID);
      end;

      bUnitsAttacked := true;
    end;
  end;
end;


procedure OnUnitAfterDied(aUnitType: Integer; aOwner: Integer; aX: Integer; aY: Integer);
begin
  if not bMessageShowed then
  begin
    if (States.StatArmyCount(3) = 0) and (States.StatArmyCount(4) = 0) then
    begin
      Actions.ShowMsg(0, '<$0>');
      bMessageShowed := true;
    end;
  end;
end;


procedure OnTick();
begin
  if (States.GameTime() = 18000) then
  begin
    Actions.UnitBlock(2, 17, false); // Bowman
    Actions.UnitBlock(2, 19, false); // Lance carrier
  end;
end;
